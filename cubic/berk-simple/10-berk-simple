# Aeon OS Berk — "Berk Simple" system-wide Cinnamon defaults
# Installed to /etc/dconf/db/local.d/ by berk-simple/apply-ux.sh, then `dconf update`.
# Only long-standing, well-known keys are set here so a wrong value can never
# break the session (Cinnamon falls back to its default for unknown values).
# Panel layout, menu-button label, and applet order are captured from the
# reference test-VM build via `dconf dump` (see CUBIC.md) and applied on top.

[org/cinnamon/desktop/interface]
gtk-theme='Mint-Y-Blue'
icon-theme='Mint-Y-Blue'
font-name='Noto Sans 12'

# First-party XP "Luna" theme (ships in this repo — no third-party download,
# so no supply-chain risk). GTK/icons stay Mint-Y-Blue: friendly blue and
# already stocked; the XP look lives in the Cinnamon shell, window borders,
# and wallpaper, which is what a 1st grader actually sees.
[org/cinnamon/theme]
name='berk-xp'

[org/cinnamon/desktop/wm/preferences]
theme='berk-xp'

# Bliss-style wallpaper
[org/cinnamon/desktop/background]
picture-uri='file:///usr/share/backgrounds/berk-bliss.jpg'
picture-uri-dark='file:///usr/share/backgrounds/berk-bliss.jpg'
picture-options='zoom'

# One bottom panel, ~48px tall, XP taskbar height. '1' is Mint's default
# bottom panel id; if the id ever differs Cinnamon ignores this harmlessly.
[org/cinnamon]
panels-height=['1:48:bottom']
